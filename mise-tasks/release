#!/bin/sh
#MISE description="Create a release tag and push it (usage: mise run release vX.X.X)"
set -eu

VERSION="${1:-}"
if [ -z "$VERSION" ]; then
  echo "Usage: mise run release vX.X.X"
  exit 1
fi

# Ensure version starts with v
case "$VERSION" in
  v*) ;;
  *) VERSION="v${VERSION}" ;;
esac

# Validate semver format (vMAJOR.MINOR.PATCH)
if ! echo "$VERSION" | grep -qE '^v[0-9]+\.[0-9]+\.[0-9]+$'; then
  echo "Error: invalid version format '${VERSION}', expected vMAJOR.MINOR.PATCH"
  exit 1
fi

# Ensure working tree is clean
status="$(git status --porcelain)"
if [ -n "$status" ]; then
  echo "Error: working tree is not clean, commit or stash changes first"
  exit 1
fi

# The release workflow publishes the CHANGELOG.md section as release notes,
# and fails without one. Catch that before the tag is pushed.
if ! grep -qE "^## \[${VERSION#v}\]" CHANGELOG.md; then
  echo "Error: no '## [${VERSION#v}]' entry in CHANGELOG.md"
  exit 1
fi

git tag "$VERSION"
echo "Created tag ${VERSION}"

git push origin "$VERSION"
echo "Pushed tag ${VERSION}"
echo ""
echo "Done. Release workflow will start automatically."
